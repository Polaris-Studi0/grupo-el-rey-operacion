{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "reply"
  ],
  "properties": {
    "intent": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "reply",
        "ask_branch",
        "human_product_lookup",
        "human_delivery_quote",
        "human_payment_verification",
        "human_credit_application",
        "finalize_order",
        "stop",
        "human_general"
      ]
    },
    "branch_id": {
      "type": "string"
    },
    "reply": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "task_question": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sales_state": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stage": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "qty"
            ],
            "properties": {
              "product_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "fulfillment_type": {
          "type": "string"
        },
        "delivery_address": {
          "type": "string"
        },
        "delivery_zone": {
          "type": "string"
        },
        "recipient_name": {
          "type": "string"
        },
        "delivery_fee": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "payment_method": {
          "type": "string"
        },
        "payment_status": {
          "type": "string"
        },
        "payment_reference": {
          "type": "string"
        },
        "customer_notes": {
          "type": "string"
        },
        "credit_document": {
          "type": "string"
        },
        "credit_phone": {
          "type": "string"
        },
        "credit_installments": {
          "type": "string"
        },
        "credit_code": {
          "type": "string"
        },
        "product_interest": {
          "type": "string"
        }
      }
    },
    "cart_operation": {
      "type": "string",
      "enum": [
        "keep",
        "replace",
        "clear"
      ]
    },
    "address_operation": {
      "type": "string",
      "enum": [
        "keep",
        "append",
        "replace"
      ]
    },
    "request_qr": {
      "type": "boolean"
    },
    "checkout_confirmed": {
      "type": "boolean"
    },
    "branch_change_confirmed": {
      "type": "boolean"
    },
    "name_confirmed": {
      "type": "boolean"
    },
    "turn_kind": {
      "type": "string",
      "enum": [
        "greeting",
        "cancel_purchase",
        "product_query",
        "followup",
        "other"
      ]
    }
  }
}
