{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grupo-el-rey-operacion",
  "compatibility_date": "2026-09-03",
  "main": "./src/worker.js",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BOT_PILOT_ENABLED": "true",
    "BOT_PUBLIC_ENABLED": "true",
    "BOT_PUBLIC_STARTED_AT": "2026-10-01T19:39:54.198Z",
    "WHATSAPP_DEMO_ENABLED": "true",
    "BOT_PILOT_STARTED_AT": "2026-09-29T05:00:41.000Z",
    "BOT_PILOT_PHONE": "573127378289",
    "N8N_AUTOMATION_URL": "https://almaceneselrey.app.n8n.cloud/webhook/el-rey-whatsapp-automation",
    "PQRS_NOTIFICATION_EMAIL": "elrey@polaris-studio.tech",
    "PQRS_FROM_EMAIL": "PQRS Almacenes El Rey <pqrs@almaceneselrey.co>",
    "PQRS_REPLY_TO_EMAIL": "elrey@polaris-studio.tech"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/privacidad", "/eliminacion-de-datos"]
  }
}
