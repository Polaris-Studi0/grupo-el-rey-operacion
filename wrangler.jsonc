{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grupo-el-rey-operacion",
  "compatibility_date": "2026-09-03",
  "main": "./src/worker.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
